#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  postinstall — runs as root after pkg files are copied to disk.
#  We need to set up LaunchAgents for the target user (not root).
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

# $USER is root during pkg postinstall — get the real console user
REAL_USER=$(stat -f "%Su" /dev/console 2>/dev/null || echo "${SUDO_USER:-$USER}")
REAL_HOME=$(eval echo "~$REAL_USER")

SYNCTOOL_SHARE="/usr/local/share/synctool"
LAUNCH_AGENTS_DIR="$REAL_HOME/Library/LaunchAgents"
LOG_DIR="$REAL_HOME/Library/Logs/SyncTool"
DATA_DIR="$REAL_HOME/Library/Application Support/SyncTool"

NODE_BIN=$(su - "$REAL_USER" -c 'command -v node 2>/dev/null || echo ""')
if [[ -z "$NODE_BIN" ]]; then
    # Try common Homebrew locations
    for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
        [[ -x "$candidate" ]] && { NODE_BIN="$candidate"; break; }
    done
fi
[[ -n "$NODE_BIN" ]] || { echo "ERROR: node not found. Install Node.js 20+ first."; exit 1; }

# ── Create directories ────────────────────────────────────────────────────────

su - "$REAL_USER" -c "mkdir -p '$LAUNCH_AGENTS_DIR' '$LOG_DIR' '$DATA_DIR'"

# ── Generate or reuse device ID ───────────────────────────────────────────────

DEVICE_ID_FILE="$DATA_DIR/device-id"
if [[ -f "$DEVICE_ID_FILE" ]]; then
    DEVICE_ID=$(cat "$DEVICE_ID_FILE")
else
    DEVICE_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
    echo "$DEVICE_ID" > "$DEVICE_ID_FILE"
    chown "$REAL_USER" "$DEVICE_ID_FILE"
fi

# ── Install LaunchAgents ──────────────────────────────────────────────────────

for label in com.synctool.api com.synctool.agent; do
    SRC="$SYNCTOOL_SHARE/launchd/${label}.plist"
    DST="$LAUNCH_AGENTS_DIR/${label}.plist"

    sed \
        -e "s|INSTALL_DIR_PLACEHOLDER/bin/node|$NODE_BIN|g" \
        -e "s|INSTALL_DIR_PLACEHOLDER|$SYNCTOOL_SHARE|g" \
        -e "s|HOME_PLACEHOLDER|$REAL_HOME|g" \
        -e "s|DEVICE_ID_PLACEHOLDER|$DEVICE_ID|g" \
        "$SRC" > "$DST"

    chown "$REAL_USER" "$DST"

    # Install pnpm deps and build if not already done
    if [[ ! -d "$SYNCTOOL_SHARE/app/packages/api/dist" ]]; then
        su - "$REAL_USER" -c "cd '$SYNCTOOL_SHARE/app' && pnpm install --frozen-lockfile && pnpm -r build" || true
    fi

    # Load as the real user
    su - "$REAL_USER" -c "launchctl unload '$DST' 2>/dev/null || true; launchctl load -w '$DST'"
done

# ── Write CLI ─────────────────────────────────────────────────────────────────

CLI_PATH="/usr/local/bin/synctool"
cat > "$CLI_PATH" << HEREDOC
#!/usr/bin/env bash
bash "$SYNCTOOL_SHARE/app/scripts/install-macos.sh" cli "\$@"
HEREDOC

# Simpler: just symlink the install script's CLI helper
# In practice, the postinstall writes a tiny forwarder
chmod +x "$CLI_PATH"

echo "SyncTool installed for user: $REAL_USER"
echo "Device ID: $DEVICE_ID"
echo "Open http://localhost:3001 to get started."

exit 0
