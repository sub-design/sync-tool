{
  "name": "agent",
  "version": "0.1.0",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "bundle": "node build-bundle.mjs",
    "test": "pnpm --filter api build && pnpm build && node --test test/*.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/lib-storage": "^3.1047.0",
    "@sync-tool/shared": "workspace:*",
    "basic-ftp": "^6.0.1",
    "chokidar": "3.6.0",
    "dotenv": "^17.4.2",
    "node-datachannel": "^0.32.3",
    "p-limit": "3.1.0",
    "p-retry": "4.6.2",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^9.0.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.0",
    "nodemon": "^3.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
